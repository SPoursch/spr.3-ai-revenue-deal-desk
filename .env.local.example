# Copy this file to .env.local and fill in the values from
# Supabase dashboard -> Project Settings -> API.
#
# .env.local is git-ignored and must never be committed.
# Use the publishable key. Never put a secret / service_role key in a
# NEXT_PUBLIC_ variable: those are bundled into browser JavaScript.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional, server-only. The fixed origin Supabase Auth redirects back to
# (Google callback, password reset link). Defaults to the production URL,
# https://ai-rev-deal-desk.vercel.app. Set it for local development so the
# auth redirects return to your dev server. Must be on the Supabase redirect
# allow-list. Never prefix it NEXT_PUBLIC_.
# APP_URL=http://localhost:3000
